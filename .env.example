# 复制为 .env，三个密钥必须替换。数据库密码使用随机字母数字，避免 URL 转义问题。
POSTGRES_PASSWORD=replace_with_random_alphanumeric_password
# 首次初始化导入；之后在「系统设置 → 访问与密钥」管理，重启不会覆盖数据库配置。
CORE_API_KEY=replace_with_random_api_key
CORE_ADMIN_KEY=replace_with_separate_random_admin_key
CORE_PORT=9080
# 服务器修改为0.0.0.0
CORE_BIND_ADDRESS=127.0.0.1
# 留空按当前请求地址生成图片 URL；也可在管理设置中填写公开域名（在线生效）。
CORE_PUBLIC_URL=
# 容器内代理示例：http://host.docker.internal:40080；留空表示直连。
CORE_PROXY_URL=
CORE_UPSTREAM_URL=https://chatgpt.com
CORE_UPSTREAM_MODEL=gpt-6
CORE_TLS_PROFILE=chrome_110
CORE_IMAGE_WORKERS=1000
CORE_IMAGE_QUEUE_SIZE=1000
# PoW 同时计算数量：0 自动使用可用 CPU 数的一半（至少 1）；正数指定上限。与图片解码/缩略图共享 CPU，等待消耗请求预算。
CORE_POW_CONCURRENCY=0
CORE_LOG_WRITERS=2
CORE_LOG_QUEUE_SIZE=2048
# 图片管理首次读取时生成缩略图的并发；已缓存直接读取。独立于图片下载/解码名额，但共享 CPU 和内存。
CORE_THUMBNAIL_CONCURRENCY=1
CORE_ACCOUNT_SLOTS=1
# 同时下载图片数：影响网络连接、带宽竞争和下载排队，与 CORE_IMAGE_WORKERS、CORE_DOWNLOAD_TIMEOUT、CORE_TOTAL_TIMEOUT 有关。
CORE_DOWNLOAD_CONCURRENCY=100
# 同时完整解码图片数：影响 CPU 和内存；下载比解码快会排队，解码等待也消耗 CORE_DOWNLOAD_TIMEOUT；不与下载并发相乘。
CORE_VALIDATION_CONCURRENCY=10
CORE_VERIFY_CONCURRENCY=50
CORE_RESPONSE_CONCURRENCY=32
CORE_DB_CONNECTIONS=32
CORE_SWITCH_RETRIES=2
CORE_DOWNLOAD_RETRIES=1
# 普通请求共用总预算；实际生成流硬超时后恢复豁免总预算，阶段时限和切号上限仍有效。
CORE_TOTAL_TIMEOUT=120s
CORE_SSE_TIMEOUT=80s
CORE_POLL_TIMEOUT=10s
CORE_DOWNLOAD_TIMEOUT=15s
CORE_METADATA_TIMEOUT=30s
CORE_AVAILABILITY_TTL=900s
CORE_MAX_IMAGE_BYTES=67108864
CORE_RESPONSE_FORMAT=url
CORE_ALLOW_USER_RESPONSE_FORMAT=true

# 聊天/搜索使用独立执行名额，但与图片及文件共享账号槽位和账号校验等资源。
CORE_TEXT_CONCURRENCY=100
# 包含账号校验、PoW、生成流、搜索补查、切号的总预算。
CORE_TEXT_TIMEOUT=180s
# PPTX/PSD 文件生成：独立执行名额与额外等待队列，队列满返回 429。
CORE_FILE_CONCURRENCY=4
CORE_FILE_QUEUE_SIZE=16
# 从接纳开始计时，包含排队/上传/生成/补查/下载；单个下载还受 CORE_DOWNLOAD_TIMEOUT 限制。
CORE_FILE_TIMEOUT=10m
# 每个导出文件大小上限（字节），默认 256 MiB。
CORE_MAX_FILE_BYTES=268435456

# 在管理页「设置 → 代理设置」保存统一的上游直连/代理设置，无需改环境变量。
# CORE_PROXY 不设置时兼容上面的 CORE_PROXY_URL；数据库保存值优先。
# 每行一个代理地址，后台以数组存储；新会话轮询，同一会话的上传下载保持所选代理。
# CORE_PROXY='{"mode":"proxy","proxies":["http://user:password@host:port","socks5://host:1080"]}'
# 全部直连：CORE_PROXY='{"mode":"direct","proxies":[]}'
# 代理商若动态轮换出口 IP，仍须在其侧配置粘性会话；本项目不再提取动态代理 API。

# 动态热池；每条刷新通道各有 CORE_VERIFY_CONCURRENCY 个独立名额。
CORE_HOT_POOL_SIZE=500
CORE_HOT_IDLE=24h
CORE_HOT_MAINTENANCE_INTERVAL=30m
CORE_COLD_MAINTENANCE_INTERVAL=24h

# 管理页/推送单次导入上限，文件写临时磁盘后分批解析。
CORE_IMPORT_MAX_MIB=128

# 图生图 /v1/images/edits：multipart 整个请求（图片、遮罩和表单）的大小上限。
CORE_EDIT_MAX_MIB=32
# prompt 上限（KB，1 KB = 1024 UTF-8 字节），支持管理设置在线修改；上游限制独立。
CORE_PROMPT_MAX_KB=128
# 参考图张数，与输出张数 n 无关；mask 数量不能多于参考图，缺少时复用最后一张。
CORE_EDIT_MAX_IMAGES=4

# Optional local post-processing to honor size=WIDTHxHEIGHT; disabled by default.
CORE_IMAGE_RESIZE_ENABLED=false

# 服务端监控历史，独立于浏览器采样，过期数据每小时分批清理。
CORE_MONITOR_INTERVAL_SECONDS=10
CORE_MONITOR_RETENTION_HOURS=168
